# ==============================================================================
# EduSphere ERP - Environment Variables Template
# ==============================================================================
# IMPORTANT: Never commit actual secrets or credentials to source control.
# Copy this file to .env and configure strong, environment-specific values.
# ==============================================================================

# Application Environment (development | test | staging | production)
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=EduSphere-ERP

# Frontend Client Origin (CORS & Email links)
FRONTEND_URL=http://localhost:5173

# Primary MongoDB Database
# For replica sets in staging/production: mongodb://username:password@host1:27017,host2:27017/edusphere?replicaSet=rs0&ssl=true
DATABASE_URL=mongodb://localhost:27017/edusphere_dev?replicaSet=rs0
DATABASE_MAX_POOL_SIZE=50

# In-Memory Cache & Session Store (Redis)
# In production, ensure Redis password authentication and TLS are enabled
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=edusphere:

# JWT Cryptographic Secrets (Minimum 32 characters, cryptographically random)
# Generate via: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_at_least_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_a_secure_random_string_at_least_32_chars
JWT_REFRESH_EXPIRY=7d

# Session Cookie Security
# In production, COOKIE_SECURE must be true and COOKIE_DOMAIN set to your domain
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Application Logging Level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info
