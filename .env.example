# ==========================================
# EDUSPHERE ERP — ENVIRONMENT TEMPLATE
# ==========================================

# SYSTEM CORE
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=EduSphere-ERP
FRONTEND_URL=http://localhost:5173

# DATABASE (MONGODB)
DATABASE_URL=mongodb://localhost:27017/edusphere_dev?replicaSet=rs0
DATABASE_MAX_POOL_SIZE=50

# IN-MEMORY CACHE & QUEUES (REDIS)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=edusphere:

# AUTHENTICATION & TOKENS
JWT_ACCESS_SECRET=super_secret_jwt_access_token_min_32_characters_long_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_min_32_characters_long_2026
JWT_REFRESH_EXPIRY=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# OBJECT STORAGE (MINIO / S3)
STORAGE_PROVIDER=MINIO
AWS_REGION=us-east-1
AWS_S3_BUCKET=edusphere-media-storage
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT=http://localhost:9000

# EMAIL (SMTP / MAILHOG / SES)
EMAIL_PROVIDER=SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
DEFAULT_FROM_EMAIL=notifications@edusphere.io

# PAYMENT GATEWAYS
PAYMENT_DEFAULT_GATEWAY=RAZORPAY
RAZORPAY_KEY_ID=rzp_test_sample_key_12345
RAZORPAY_KEY_SECRET=rzp_test_sample_secret_67890
STRIPE_SECRET_KEY=sk_test_sample_key_12345
STRIPE_WEBHOOK_SECRET=whsec_sample_secret_67890

# OBSERVABILITY & LOGGING
LOG_LEVEL=info
SENTRY_DSN=
