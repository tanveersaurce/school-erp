{
  "name": "@edusphere/api",
  "version": "1.0.0",
  "description": "Express REST API backend for EduSphere ERP",
  "main": "./dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/auth.matrix.test.ts tests/rbac.matrix.test.ts",
    "test:integration": "vitest run tests/*.matrix.test.ts tests/state.machine.test.ts tests/storage.worker.test.ts",
    "test:e2e": "vitest run tests/e2e.user.journeys.test.ts",
    "test:security": "vitest run tests/auth.matrix.test.ts tests/rbac.matrix.test.ts tests/multitenant.matrix.test.ts",
    "test:concurrency": "vitest run tests/concurrency.matrix.test.ts tests/financial.integrity.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@edusphere/common": "^1.0.0",
    "@edusphere/database": "^1.0.0",
    "@edusphere/types": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "pino": "^9.5.0",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "mongodb-memory-server": "^10.1.2",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
