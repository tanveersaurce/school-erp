{
  "name": "@edusphere/database",
  "version": "1.0.0",
  "description": "Shared MongoDB Mongoose models, plugins, seeders, and schemas for EduSphere ERP",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "import": "./dist/seed/index.js",
      "default": "./dist/seed/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx src/seed/index.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@edusphere/common": "^1.0.0",
    "@edusphere/types": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "mongoose": "^8.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "mongodb-memory-server": "^10.1.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
